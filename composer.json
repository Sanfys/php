{
    "name": "student/ci-cd-lab",
    "description": "Minimal PHP project for CI/CD testing",
    "require": {
        "php": "^8.2",
        "fakerphp/faker": "^1.23"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Services/EntityService.php",
            "app/Services/DataProcessor.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
