@startuml class-diagram
title Діаграма класів: Інтернет-магазин (Laravel / MVC)
skinparam defaultFontName DejaVu Sans
skinparam dpi 220
skinparam defaultFontSize 9
skinparam classFontSize 10
skinparam classAttributeFontSize 9
skinparam roundCorner 4
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 34
skinparam ranksep 70
skinparam class {
  BackgroundColor #F5F9FF
  BorderColor #2F5597
  ArrowColor #2F5597
  HeaderBackgroundColor #DCE6F5
}
skinparam stereotypeCBackgroundColor #DCE6F5

abstract class User <<Model>> {
  +id: int
  +name: string
  +email: string
  -password: string
  +created_at: DateTime
  --
  +register(data: array): User
  +login(email: string, password: string): bool
  +logout(): void
  +updateProfile(data: array): bool
  +changePassword(old: string, new: string): bool
}

class Customer <<Model>> {
  +phone: string
  +loyalty_points: int
  +birth_date: Date
  +is_subscribed: bool
  +last_login_at: DateTime
  --
  +placeOrder(cart: Cart): Order
  +getOrderHistory(): Order[]
  +addReview(product: Product, rating: int, comment: string): Review
  +addLoyaltyPoints(points: int): void
  +subscribe(flag: bool): void
}

class Administrator <<Model>> {
  +role_level: int
  +department: string
  +permissions: array
  +is_super: bool
  +last_action_at: DateTime
  --
  +createProduct(data: array): Product
  +updateProduct(id: int, data: array): bool
  +deleteProduct(id: int): bool
  +changeOrderStatus(order: Order, status: string): bool
  +generateSalesReport(from: Date, to: Date): array
}

class Address <<Model>> {
  +id: int
  +user_id: int
  +city: string
  +street: string
  +postal_code: string
  --
  +getFullAddress(): string
  +validate(): bool
  +setAsDefault(): void
  +update(data: array): bool
  +delete(): bool
}

class Category <<Model>> {
  +id: int
  +name: string
  +slug: string
  +description: string
  +parent_id: int
  --
  +getProducts(): Product[]
  +addProduct(product: Product): void
  +removeProduct(id: int): void
  +getChildren(): Category[]
  +isRoot(): bool
}

class Product <<Model>> {
  +id: int
  +name: string
  +sku: string
  +price: float
  +stock_quantity: int
  +description: string
  +is_active: bool
  +category_id: int
  --
  +calculateTotalPrice(quantity: int): float
  +applyDiscount(percent: float): float
  +isAvailable(quantity: int): bool
  +decreaseStock(quantity: int): void
  +getAverageRating(): float
}

class Review <<Model>> {
  +id: int
  +product_id: int
  +user_id: int
  +rating: int
  +comment: string
  --
  +publish(): bool
  +edit(rating: int, comment: string): bool
  +delete(): bool
  +approve(): void
  +getAuthor(): Customer
}

class Cart <<Model>> {
  +id: int
  +user_id: int
  +total_amount: float
  +created_at: DateTime
  +updated_at: DateTime
  --
  +addItem(product: Product, quantity: int): CartItem
  +removeItem(itemId: int): void
  +updateQuantity(itemId: int, quantity: int): void
  +clear(): void
  +calculateTotal(): float
}

class CartItem <<Model>> {
  +id: int
  +cart_id: int
  +product_id: int
  +quantity: int
  +added_at: DateTime
  --
  +getSubtotal(): float
  +increase(by: int): void
  +decrease(by: int): void
  +getProduct(): Product
  +remove(): void
}

class Order <<Model>> {
  +id: int
  +user_id: int
  +status: string
  +total_amount: float
  +created_at: DateTime
  --
  +addItem(product: Product, quantity: int): OrderItem
  +calculateTotal(): float
  +changeStatus(status: string): bool
  +cancel(): bool
  +getItems(): OrderItem[]
}

class OrderItem <<Model>> {
  +id: int
  +order_id: int
  +product_id: int
  +quantity: int
  +unit_price: float
  --
  +getSubtotal(): float
  +setQuantity(quantity: int): void
  +getProduct(): Product
  +increase(by: int): void
  +decrease(by: int): void
}

class Payment <<Model>> {
  +id: int
  +order_id: int
  +amount: float
  +method: string
  +status: string
  --
  +process(): bool
  +refund(): bool
  +cancel(): void
  +isSuccessful(): bool
  +getReceipt(): string
}

class ProductController <<Controller>> {
  -productService: ProductService
  -request: Request
  -perPage: int
  -viewName: string
  -cacheTtl: int
  --
  +index(): View
  +show(id: int): View
  +store(request: Request): Response
  +update(request: Request, id: int): Response
  +destroy(id: int): Response
}

class OrderController <<Controller>> {
  -orderService: OrderService
  -paymentGateway: PaymentGateway
  -request: Request
  -viewName: string
  -perPage: int
  --
  +index(): View
  +show(id: int): View
  +store(request: Request): Response
  +cancel(id: int): Response
  +updateStatus(request: Request, id: int): Response
}

' ===== Наслідування (generalization) =====
Customer --|> User
Administrator --|> User

' ===== Композиція (час життя частини = час життя цілого) =====
Customer "1" *-- "0..*" Address : має
Customer "1" *-- "1" Cart : володіє
Cart "1" *-- "0..*" CartItem : містить
Order "1" *-- "1..*" OrderItem : складається з

' ===== Агрегація (частина існує незалежно від цілого) =====
Category "1" o-- "0..*" Product : групує
Order "1" o-- "0..*" Payment : оплачується

' ===== Асоціація =====
Customer "1" --> "0..*" Order : оформлює
Customer "1" --> "0..*" Review : пише
Review "0..*" --> "1" Product : стосується
CartItem "0..*" --> "1" Product : посилається на
OrderItem "0..*" --> "1" Product : посилається на

' ===== Залежності контролерів від моделей =====
ProductController ..> Product : керує
ProductController ..> Category
OrderController ..> Order : керує
OrderController ..> Payment
Administrator ..> Product : адмініструє
@enduml
