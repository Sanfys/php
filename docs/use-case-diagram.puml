@startuml use-case-diagram
title Діаграма варіантів використання: Інтернет-магазин
skinparam defaultFontName DejaVu Sans
skinparam dpi 160
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #2F5597
  ArrowColor #2F5597
}
skinparam actor {
  BackgroundColor #FFF2CC
  BorderColor #7F6000
}
left to right direction

actor "Гість" as Guest
actor "Покупець" as Customer
actor "Адміністратор" as Admin

rectangle "Інтернет-магазин" {
  ' Гість
  usecase "Переглянути каталог\nтоварів" as UC1
  usecase "Знайти товар" as UC2
  usecase "Зареєструватися" as UC3
  usecase "Знайти за\nкатегорією" as UC2a
  usecase "Знайти за\nназвою" as UC2b

  ' Покупець
  usecase "Оформити\nзамовлення" as UC4
  usecase "Оплатити\nзамовлення" as UC5
  usecase "Переглянути історію\nзамовлень" as UC6
  usecase "Додати товар\nдо кошика" as UC10
  usecase "Застосувати\nпромокод" as UC11

  ' Адміністратор
  usecase "Керувати товарами" as UC7
  usecase "Керувати\nзамовленнями" as UC8
  usecase "Переглянути звіти\nпродажів" as UC9
  usecase "Видалити товар" as UC14
}

' Узагальнення акторів
Customer --|> Guest
Admin --|> Customer

' Асоціації (по 3 варіанти використання на актора)
Guest --> UC1
Guest --> UC2
Guest --> UC3

Customer --> UC4
Customer --> UC5
Customer --> UC6

Admin --> UC7
Admin --> UC8
Admin --> UC9

' Узагальнення варіантів використання
UC2a --|> UC2
UC2b --|> UC2

' Включення (include)
UC4 ..> UC10 : <<include>>
UC4 ..> UC5 : <<include>>

' Розширення (extend)
UC11 ..> UC4 : <<extend>>
UC14 ..> UC7 : <<extend>>
@enduml
